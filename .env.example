# Generate .env with: python scripts/setup_platform.py
POSTGRES_PASSWORD=replace-with-random-database-password
PLATFORM_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-random-characters
# Enable Secure cookies when served behind HTTPS.
COOKIE_SECURE=false
# Comma-separated exact origins; empty means same-origin only.
ALLOWED_ORIGINS=
# Explicit intranet target hostnames/IPs authorized for outbound API evaluations.
ALLOWED_PRIVATE_HOSTS=

# Encrypted online audit originals, restricted access with operation logging.
AUDIT_RAW_RETENTION_DAYS=7
